    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 1. Transformer en tableau JSON simple\nconst leads = items.map(i => i.json).filter(l => l.id);\n\nif (leads.length === 0) {\n  return [{\n    json: {\n      success: true,\n      status: 'not_found',\n      message: 'No leads found for this session.'\n    }\n  }];\n}\n\n// 2. Trier TOUS les leads par date de création (dernière activité en premier)\nleads.sort((a, b) => {\n  const dateA = a.created_at ? new Date(a.created_at) : new Date(0);\n  const dateB = b.created_at ? new Date(b.created_at) : new Date(0);\n  return dateB - dateA;\n});\n\n// 3. Prendre la décision basée sur le lead le plus récent\nconst latestLead = leads[0];\nconsole.log('Latest Lead found:', latestLead.id, latestLead.payment_status);\n\n// Si le plus récent est en attente de paiement, on donne le lien\nif (latestLead.payment_status === 'payment_pending') {\n  const stripeUrl = latestLead.payment_url || latestLead.stripe_payment_url;\n  \n  if (stripeUrl) {\n    return [{\n      json: {\n        success: true,\n        status: 'ready',\n        stripe_url: stripeUrl,\n        message: 'Payment link is ready'\n      }\n    }];\n  }\n}\n\n// Si le plus récent est déjà payé, on informe\nif (latestLead.payment_status === 'paid') {\n  return [{\n    json: {\n      success: true,\n      status: 'paid',\n      message: 'Payment already completed for the latest session.'\n    }\n  }];\n}\n\n// Par défaut, si rien n'est clair (ou si le lien manque sur un pending)\nreturn [{\n  json: {\n    success: true,\n    status: 'pending',\n    message: 'Processing your request...'\n  }\n}];"
      },
