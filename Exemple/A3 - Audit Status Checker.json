      "parameters": {
        "jsCode": "try {\r\n  // Accessing nodes results using the modern syntax\r\n  const sessionResult = $(\"Lookup by Session ID\").all();\r\n  const emailResult = $(\"Fallback Lookup by Email\").all();\r\n  \r\n  let lead = null;\r\n  \r\n  console.log(`📊 Session results: ${sessionResult.length} | Email results: ${emailResult.length}`);\r\n  \r\n  // Check session results FIRST (priorité)\r\n  if (sessionResult && sessionResult.length > 0 && sessionResult[0].json && sessionResult[0].json.id) {\r\n    lead = sessionResult[0].json;\r\n    console.log(`✅ Found by session_id: ${lead.email}`);\r\n  }\r\n  // Check email results if session failed OR if session_id was not provided\r\n  else if (emailResult && emailResult.length > 0 && emailResult[0].json && emailResult[0].json.id) {\r\n    lead = emailResult[0].json;\r\n    console.log(`✅ Found by email: ${lead.email}`);\r\n  }\r\n  \r\n  if (lead) {\r\n    const auditSent = lead.audit_sent;\r\n    const isReady = (auditSent === true || auditSent === \"true\" || String(auditSent).toLowerCase() === \"true\") && \r\n                    lead.pdf_download_url && \r\n                    String(lead.pdf_download_url).startsWith(\"http\");\r\n\r\n    if (isReady) {\r\n      console.log(`✅ Audit ready for ${lead.first_name}`);\r\n      return [{\r\n        json: {\r\n          status: \"ready\",\r\n          download_url: lead.pdf_download_url,\r\n          first_name: lead.first_name || \"Client\"\r\n        }\r\n      }];\r\n    } else {\r\n      console.log(`⏳ Audit still processing for ${lead.first_name}`);\r\n      return [{\r\n        json: {\r\n          status: \"processing\",\r\n          message: \"AI is generating your audit...\"\r\n        }\r\n      }];\r\n    }\r\n  }\r\n\r\n  console.log(`❌ Lead not found`);\r\n  return [{\r\n    json: {\r\n      status: \"not_found\",\r\n      message: \"Waiting for payment confirmation...\"\r\n    }\r\n  }];\r\n} catch (e) {\r\n  console.error(`🚨 Error: ${e.message}`);\r\n  return [{\r\n    json: {\r\n      status: \"error\",\r\n      message: e.message\r\n    }\r\n  }];\r\n}"
