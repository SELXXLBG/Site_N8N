    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nif (!body || !body.data || !Array.isArray(body.data.fields)) {\n  throw new Error('Structure Tally invalide');\n}\nconst fields = body.data.fields;\n\n// Résout un champ : si MULTIPLE_CHOICE/CHECKBOXES, mappe les UUIDs → textes via options[]\nfunction resolve(field) {\n  if (!field) return 'Non renseigné';\n  const v = field.value;\n  if (v === null || v === undefined || v === '' || v === false) return 'Non renseigné';\n  if (typeof v === 'boolean') return v ? 'Oui' : 'Non';\n  if (Array.isArray(v) && field.options && field.options.length > 0) {\n    const texts = v.map(uuid => {\n      const opt = field.options.find(o => o.id === uuid);\n      return opt ? opt.text : uuid;\n    }).filter(Boolean);\n    return texts.length > 0 ? texts.join(', ') : 'Non renseigné';\n  }\n  if (Array.isArray(v)) return v.join(', ') || 'Non renseigné';\n  return String(v).trim() || 'Non renseigné';\n}\n\n// Cherche par label (insensible casse, trim)\nfunction getByLabel(...labels) {\n  for (const lbl of labels) {\n    const f = fields.find(f => f.label && f.label.trim().toLowerCase() === lbl.trim().toLowerCase());\n    if (f) return resolve(f);\n  }\n  return 'Non renseigné';\n}\n\n// Détection langue via champ dédié ou valeur par défaut FR\nconst langueRaw = getByLabel('Langue', 'Language', 'Langue préférée');\nconst langue = langueRaw.toLowerCase().includes('en') || langueRaw.toLowerCase().includes('english') ? 'en' : 'fr';\n\nreturn [{\n  json: {\n    respondentId: body.data.respondentId || '',\n    submissionId: body.data.submissionId || '',\n    nom:        getByLabel('Prénom et Nom', 'Nom complet', 'Nom', 'Prénom'),\n    email:      getByLabel('Email professionnel', 'Email', 'Adresse email'),\n    site:       getByLabel('Site e-commerce (URL)', 'Site web', 'URL du site', 'Site'),\n    plateforme: getByLabel('Plateforme utilisée', 'Plateforme e-commerce', 'Plateforme'),\n    ca:         getByLabel('Taille de la boutique', 'Chiffre d\\'affaires mensuel', 'CA mensuel', 'Revenus'),\n    probleme:   getByLabel('Problème principal', 'Probleme principal', 'Défi principal'),\n    objectif:   getByLabel('Objectif business principal', 'Objectif principal', 'Objectif'),\n    budget:     getByLabel('Budget estimé', 'Budget mensuel', 'Budget'),\n    urgence:    getByLabel('Urgence', 'Délai souhaité', 'Timeline'),\n    autoExist:  getByLabel('Automatisations déjà en place', 'Automatisations existantes', 'Outils actuels'),\n    source:     getByLabel('Source de découverte', 'Source', 'Comment nous avez-vous trouvé'),\n    langue\n  }\n}];"
      },
