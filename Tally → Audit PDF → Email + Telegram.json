    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nif (!body || !body.data || !Array.isArray(body.data.fields)) {\n  throw new Error('Structure Tally invalide');\n}\nconst fields = body.data.fields;\n\n// Résout un champ\nfunction resolve(field) {\n  if (!field) return 'Non renseigné';\n  const v = field.value;\n  if (v === null || v === undefined || v === '' || v === false) return 'Non renseigné';\n  if (typeof v === 'boolean') return v ? 'Oui' : 'Non';\n  if (Array.isArray(v) && field.options && field.options.length > 0) {\n    const texts = v.map(uuid => {\n      const opt = field.options.find(o => o.id === uuid);\n      return opt ? opt.text : uuid;\n    }).filter(Boolean);\n    return texts.length > 0 ? texts.join(', ') : 'Non renseigné';\n  }\n  if (Array.isArray(v)) return v.join(', ') || 'Non renseigné';\n  return String(v).trim() || 'Non renseigné';\n}\n\n// Cherche par label (fuzzy match)\nfunction getByLabel(...labels) {\n  const normalizedLabels = labels.map(l => l.toLowerCase().trim());\n  const f = fields.find(field => {\n    if (!field.label) return false;\n    const fl = field.label.toLowerCase();\n    return normalizedLabels.some(nl => fl.includes(nl));\n  });\n  return f ? resolve(f) : 'Non renseigné';\n}\n\n// Détection langue via payload root de Tally ou labels spécifiques\nconst langPayload = body.data.formLanguage || body.data.lang || '';\nconst langueRaw = getByLabel('Langue', 'Language', 'Langue préférée', 'Preferred language');\nconst isEnglish = langPayload.toLowerCase().includes('en') || \n                  langueRaw.toLowerCase().includes('en') || \n                  langueRaw.toLowerCase().includes('english') ||\n                  langueRaw === 'English';\n\nconst langue = isEnglish ? 'en' : 'fr';\n\n// Nettoyage de l'ID (certains paramètres peuvent inclure des suffixes comme emojis/langue)\nconst rawId = body.data.respondentId || '';\nconst respondentId = rawId.trim().split(/[\\s🇺🇸🇬🇧🇫🇷]/)[0] || rawId;\n\nreturn [{\n  json: {\n    respondentId,\n    submissionId: body.data.submissionId || '',\n    nom:        getByLabel('Prénom et Nom', 'Nom complet', 'Nom', 'Name'),\n    email:      getByLabel('Email professionnel', 'Email', 'Adresse email'),\n    site:       getByLabel('Site e-commerce (URL)', 'Site web', 'URL du site', 'Website'),\n    plateforme: getByLabel('Plateforme utilisée', 'Plateforme e-commerce', 'Platform'),\n    ca:         getByLabel('Taille de la boutique', 'Chiffre d\\'affaires mensuel', 'CA mensuel', 'Revenue'),\n    probleme:   getByLabel('Problème principal', 'Probleme principal', 'Main problem'),\n    objectif:   getByLabel('Objectif business principal', 'Objectif principal', 'Goal'),\n    budget:     getByLabel('Budget estimé', 'Budget mensuel', 'Budget'),\n    urgence:    getByLabel('Urgence', 'Délai souhaité', 'Timeline'),\n    autoExist:  getByLabel('Automatisations déjà en place', 'Automatisations existantes', 'Existing tools'),\n    source:     getByLabel('Source de découverte', 'Source', 'How did you find us'),\n    langue\n  }\n}];"
      },
