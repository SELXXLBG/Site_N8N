    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nif (!body || !body.data || !Array.isArray(body.data.fields)) {\n  throw new Error('Structure Tally invalide: ' + JSON.stringify(body).substring(0,200));\n}\nconst fields = body.data.fields;\n\nfunction resolve(field) {\n  if (!field) return 'Non renseigné';\n  const v = field.value;\n  if (v === null || v === undefined || v === '' || v === false) return 'Non renseigné';\n  if (typeof v === 'boolean') return v ? 'Oui' : 'Non';\n  if (Array.isArray(v) && field.options && field.options.length > 0) {\n    const texts = v.map(uuid => {\n      const opt = field.options.find(o => o.id === uuid);\n      return opt ? opt.text : null;\n    }).filter(Boolean);\n    return texts.length > 0 ? texts.join(', ') : 'Non renseigné';\n  }\n  if (Array.isArray(v)) return v.filter(Boolean).join(', ') || 'Non renseigné';\n  return String(v).trim() || 'Non renseigné';\n}\n\nfunction get(...labels) {\n  for (const lbl of labels) {\n    const f = fields.find(f => f.label && f.label.trim().toLowerCase() === lbl.trim().toLowerCase());\n    if (f) {\n      const val = resolve(f);\n      if (val && val !== 'Non renseigné') return val;\n    }\n  }\n  return 'Non renseigné';\n}\n\nconst langueRaw = get('langue', 'language', 'langue préférée', 'preferred language');\nconst langue = (langueRaw.toLowerCase().includes('en') || langueRaw.toLowerCase().includes('english') || langueRaw.toLowerCase().includes('anglais')) ? 'en' : 'fr';\n\nreturn [{ json: {\n  respondentId: (body.data.respondentId || body.data.submissionId || '').toString(),\n  submissionId: (body.data.submissionId || '').toString(),\n  nom:        get('prénom et nom', 'nom complet', 'prénom', 'nom', 'full name', 'name'),\n  email:      get('email professionnel', 'email', 'adresse email', 'e-mail', 'professional email'),\n  site:       get('site e-commerce (url)', 'site web', 'url du site', 'site', 'website url', 'website'),\n  plateforme: get('plateforme utilisée', 'plateforme e-commerce', 'plateforme', 'platform'),\n  ca:         get('taille de la boutique', \"chiffre d'affaires mensuel\", 'ca mensuel', 'revenus', 'monthly revenue'),\n  probleme:   get('problème principal', 'probleme principal', 'défi principal', 'main challenge', 'main problem'),\n  objectif:   get('objectif business principal', 'objectif principal', 'objectif', 'goal', 'main goal'),\n  budget:     get('budget estimé', 'budget mensuel', 'budget'),\n  urgence:    get('urgence', 'délai souhaité', 'timeline', 'quand souhaitez-vous démarrer'),\n  autoExist:  get('automatisations déjà en place', 'automatisations existantes', 'outils actuels', 'existing tools'),\n  source:     get('source de découverte', 'source', 'comment nous avez-vous trouvé', 'how did you find us'),\n  langue\n} }];\n"
      },
